# ============================================================
# Ron con Cola — variables de entorno
#
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
# ============================================================

# --- Supabase (OBLIGATORIO) -------------------------------
# Supabase → Project Settings → API
# La "publishable key" es publica por diseno: queda visible en el
# navegador. Lo que protege los datos son las politicas RLS y las
# funciones SECURITY DEFINER de supabase/migraciones/004_seguridad.sql
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- WhatsApp (OBLIGATORIO para el boton de pedido) -------
# Numero del negocio con codigo de pais, solo digitos.
# Ejemplo para Peru: 51987654321
# Si queda vacio, el pedido SE GUARDA IGUAL con su codigo,
# pero el boton de WhatsApp aparece desactivado.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# --- Claude (OPCIONAL) ------------------------------------
# Da las sugerencias de categoria, la deteccion de duplicados
# redactada y el asistente comercial.
# Sin esta llave el sistema NO se cae: usa reglas locales
# deterministas y lo avisa en pantalla como "modo demostracion".
# Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=
MODELO_IA=claude-sonnet-5-5
